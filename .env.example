# Admin login — sees every client workspace and the cross-client overview.
# Required: there is no default, and auth fails closed if either is unset.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# One block per client. {ID} becomes the client's internal id (lowercased),
# so CLIENT_ACME_* creates the client "acme". NAME, MCP_URL, USERNAME and
# PASSWORD are all required or the client is skipped.
#
# PROVIDER is optional — it is inferred from the MCP host (a *.smartlead.ai
# URL means smartlead, anything else means instantly). Set it explicitly only
# to override that guess.
#
# MCP URLs contain the platform API key. Treat them as secrets.

# --- Instantly client ---
CLIENT_ACME_NAME=Acme Corp
CLIENT_ACME_MCP_URL=https://mcp.instantly.ai/mcp/INSTANTLY_API_KEY
CLIENT_ACME_USERNAME=acme
CLIENT_ACME_PASSWORD=
# CLIENT_ACME_PROVIDER=instantly

# --- Smartlead client ---
# Both of these forms work; the key is pulled out of the URL either way.
#   https://mcp.smartlead.ai/sse?smartlead_user_api_key=KEY
#   https://mcp.smartlead.ai/sse?KEY
CLIENT_BETA_NAME=Beta Inc
CLIENT_BETA_MCP_URL=https://mcp.smartlead.ai/sse?smartlead_user_api_key=SMARTLEAD_API_KEY
CLIENT_BETA_USERNAME=beta
CLIENT_BETA_PASSWORD=
# CLIENT_BETA_PROVIDER=smartlead
